# Provedor da LLM: 'ollama', 'openai-compatible' (llama-server) ou 'gemini'
LLM_PROVIDER=ollama

# Se usar Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Modelos recomendados para RTX 4070 Ti (12GB VRAM):
# - qwen3.5:9b-24k   -> Recomendado: uso geral, busca web com Tavily, Obsidian e tool calling (~70-90 tok/s)
# - qwen3.5:4b       -> Ultrarrápido (>120 tok/s)
OLLAMA_MODEL=qwen3.5:9b-24k

# Se usar llama-server (llama.cpp direto)
# LLM_PROVIDER=openai-compatible
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_MODEL=qwen2.5-14b

# Se usar Google Gemini (Google AI Studio Free Tier)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=sua_chave_do_aistudio_aqui
# GEMINI_MODEL=gemini-1.5-flash

# Provedor de Busca Web: 'tavily' (Recomendado para IA - 1000 buscas grátis/mês) ou 'searxng' (local Docker)
# Se TAVILY_API_KEY estiver preenchida, 'tavily' é selecionado automaticamente.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-sua_chave_aqui

# Se usar SearXNG Local (Docker)
SEARXNG_BASE_URL=http://localhost:8080

# Integração com Telegram Bot (Issue #2)
# Token obtido com o @BotFather no Telegram (ex: 7123456789:AAFlkB4...)
TELEGRAM_BOT_TOKEN=
# Seu ID numérico no Telegram (obtenha via @userinfobot ou veja no log do terminal)
# Suporta múltiplos IDs separados por vírgula (ex: 123456789,987654321)
TELEGRAM_ALLOWED_USER_ID=

# Diretórios permitidos para o agente ler, listar e escrever (separados por vírgula)
# Se não preenchido, o padrão seguro é apenas o diretório do projeto (process.cwd())
ALLOWED_DIRECTORIES=G:\ProjetosAleatorios\ProjetoAgentePessoal,G:\CofreObsidian\AgentePessoal

# Caminho do Cofre do Obsidian (usado para notas e finanças)
OBSIDIAN_VAULT_PATH=G:\CofreObsidian\AgentePessoal


