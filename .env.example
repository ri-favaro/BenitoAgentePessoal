# Provedor da LLM: 'ollama', 'openai-compatible' (llama-server) ou 'gemini'
LLM_PROVIDER=ollama

# Se usar Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Modelos recomendados para RTX 4070 Ti (12GB VRAM):
# - qwen2.5:14b       -> Recomendado: uso geral, organização, Obsidian e alta fidelidade em tool calling (~40 tok/s)
# - qwen2.5-coder:14b -> Recomendado: foco em código, automações técnicas e JSON estrito
# - qwen2.5:7b        -> Ultrarrápido (~80 tok/s), mas suscetível a erros de schema em ferramentas complexas
OLLAMA_MODEL=qwen2.5:14b

# Se usar llama-server (llama.cpp direto)
# LLM_PROVIDER=openai-compatible
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_MODEL=qwen2.5-14b

# Se usar Google Gemini (Google AI Studio Free Tier)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=sua_chave_do_aistudio_aqui
# GEMINI_MODEL=gemini-1.5-flash

# Busca Web Local e Gratuita (SearXNG via Docker)
SEARXNG_BASE_URL=http://localhost:8080


